# Embeds the Enhanced UI's TrueType fonts (third_party/fonts, SIL OFL 1.1) into the binary as byte
# arrays, so the command-line binary and the app bundle need no font files at run time.
# Generates ${CMAKE_BINARY_DIR}/generated/embedded_fonts.cpp defining
#   d2k::render::embeddedFont(const char* name, std::size_t& size) -> const unsigned char*.
function(d2k_embed_fonts out_var)
    set(_fonts
        "play_regular;${CMAKE_SOURCE_DIR}/third_party/fonts/play/Play-Regular.ttf"
        "play_bold;${CMAKE_SOURCE_DIR}/third_party/fonts/play/Play-Bold.ttf")
    set(_out "${CMAKE_BINARY_DIR}/generated/embedded_fonts.cpp")
    set(_body "// Generated by cmake/EmbedFonts.cmake - do not edit.\n#include <cstddef>\n#include <cstring>\nnamespace d2k::render {\nnamespace {\n")
    set(_lookup "")
    list(LENGTH _fonts _n)
    math(EXPR _last "${_n} - 1")
    foreach(_i RANGE 0 ${_last} 2)
        math(EXPR _j "${_i} + 1")
        list(GET _fonts ${_i} _name)
        list(GET _fonts ${_j} _path)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_path}")
        file(READ "${_path}" _hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
        string(APPEND _body "const unsigned char k_${_name}[] = {${_hex}};\n")
        string(APPEND _lookup "    if (std::strcmp(name, \"${_name}\") == 0) { size = sizeof k_${_name}; return k_${_name}; }\n")
    endforeach()
    string(APPEND _body "}  // namespace\nconst unsigned char* embeddedFont(const char* name, std::size_t& size) {\n${_lookup}    size = 0;\n    return nullptr;\n}\n}  // namespace d2k::render\n")
    file(WRITE "${_out}.tmp" "${_body}")
    file(COPY_FILE "${_out}.tmp" "${_out}" ONLY_IF_DIFFERENT)
    set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()
