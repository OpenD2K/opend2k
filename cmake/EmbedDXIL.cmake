# Script mode (cmake -P), run by cmake/CompileShadersDXIL.cmake: compiles every entry point of
# shaders.hlsl with dxc (shader model 6.0, as SDL_gpu's D3D12 backend requires) and writes them
# as byte arrays kDxil_<entry> into OUT. Inputs: -DDXC=<dxc> -DSRC=<shaders.hlsl> -DOUT=<.inc>.
# The entry list matches tools/compile_shaders.sh and render3d/shader_blobs.cpp.
set(_entries
    "terrain_vs;vs" "terrain_fs;ps" "sprite_vs;vs" "sprite_fs;ps"
    "model_vs;vs" "model_shadow_vs;vs" "model_fs;ps" "shadow_fs;ps"
    "terrain2_fs;ps" "rock_vs;vs" "rock_fs;ps" "depth_fs;ps" "terrain3_fs;ps" "tonemap_fs;ps")
get_filename_component(_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_dir}")
set(_body "// Generated by cmake/EmbedDXIL.cmake from src/render3d/shaders.hlsl - do not edit.\n")
list(LENGTH _entries _n)
math(EXPR _last "${_n} - 1")
foreach(_i RANGE 0 ${_last} 2)
    math(EXPR _j "${_i} + 1")
    list(GET _entries ${_i} _name)
    list(GET _entries ${_j} _stage)
    set(_blob "${_dir}/${_name}.dxil")
    execute_process(
        COMMAND "${DXC}" -nologo -T ${_stage}_6_0 -E ${_name} -O3 -Qstrip_debug -Qstrip_reflect
                -Fo "${_blob}" "${SRC}"
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _log ERROR_VARIABLE _log)
    if(NOT _rc EQUAL 0 OR NOT EXISTS "${_blob}")
        message(FATAL_ERROR "dxc failed for ${_name} (${_rc}):\n${_log}")
    endif()
    file(READ "${_blob}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    if(_len LESS 8)
        message(FATAL_ERROR "dxc produced an empty blob for ${_name}")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
    string(APPEND _body "alignas(4) inline constexpr unsigned char kDxil_${_name}[] = {${_hex}};\n")
endforeach()
file(WRITE "${OUT}.tmp" "${_body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
